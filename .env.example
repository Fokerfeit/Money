# MONEY server — example environment configuration.
# Copy to .env (gitignored) on the deployment host and fill in real values.

# Comma-separated MONEY addresses allowed to RECEIVE transfers without having
# ignited via the faucet (marketplaces, platform wallets, etc.). They are not
# faucet users and hold no minted balance, but can spend what they receive.
# nocopycART platform wallet:
MONEY_PLATFORM_ADDRESSES=M_F66DCDBCD2FA68D8FCEE50A503CFBA20

# Trust this many reverse-proxy hops for client-IP detection (rate limiting +
# ignition throttle). 1 is correct behind a single HTTPS proxy. Set 0 for a
# directly-exposed server.
TRUST_PROXY=1

# Optional: directory for ledger.json / google_accounts.json / replay_fence.json
# (defaults to the server.js directory). Used by tests to isolate data.
# MONEY_DATA_DIR=/var/lib/money

# Set to "test" to relax the ignition throttle (1000/hr) for the attack sim.
# NODE_ENV=production
